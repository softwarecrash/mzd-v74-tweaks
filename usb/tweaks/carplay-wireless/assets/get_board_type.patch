+        exit 1
+    fi
+done
 
+logger -t board "caller=$(cat /proc/$PPID/comm 2>/dev/null) ret=2 (WCP Enabled)"
+echo "$(date +%T) caller=$(cat /proc/$PPID/comm 2>/dev/null) ret=2 (WCP Enabled)" >> /tmp/wcp_board.log
+exit 2
