#!/bin/sh
# @TITLE_COMMENT@ for Mazda firmware 74.00.324.
# Generated by build/tweaks/render_installers.py; requires the packaged lib/.
set -u

# Help and invalid actions work even if a library is missing. No imports or
# storage operations happen until a real, valid action has been requested.
mzd_worker_usage() {
    echo 'Usage: sh run.sh <install|uninstall|status>'
    echo 'No arguments or --help: show usage without changing anything.'
}

if [ "$#" -gt 1 ]
then
    echo 'Expected exactly one action, or no arguments for usage.' >&2
    mzd_worker_usage >&2
    exit 1
fi
ACTION=${1:-}
case "$ACTION" in
    ''|--help|-h)
        mzd_worker_usage
        exit 0
        ;;
    install|uninstall|status)
        ;;
    *)
        echo 'Unknown action. Use install, uninstall or status.' >&2
        exit 1
        ;;
esac

# The only duplicated bootstrap: validate dependencies before sourcing them.
SELF=$(readlink -f "$0") || exit 1
HERE=$(dirname "$SELF")
LIBDIR=$(readlink -f "$HERE/../../lib") || exit 1
for MZD_LIBRARY in @LIBRARY_FILES@
do
    MZD_FILE="$LIBDIR/$MZD_LIBRARY"
    if [ ! -f "$MZD_FILE" ] || [ -L "$MZD_FILE" ]
    then
        printf 'Missing or linked library: %s\n' "$MZD_FILE" >&2
        exit 1
    fi
    MZD_EXPECTED=$(cut -c1-32 "$MZD_FILE.md5" 2>/dev/null)
    MZD_ACTUAL=$(md5sum "$MZD_FILE" | cut -d' ' -f1)
    if [ -z "$MZD_EXPECTED" ] || [ "$MZD_EXPECTED" != "$MZD_ACTUAL" ]
    then
        printf 'Library checksum mismatch: %s\n' "$MZD_FILE" >&2
        exit 1
    fi
done

. "$LIBDIR/common.sh"
. "$LIBDIR/system.sh"
. "$LIBDIR/patch.sh"
REQUIRED_LIBRARY_API=@LIBRARY_API@
if [ "$(mzd_common_api):$(mzd_system_api):$(mzd_patch_api)" != "$REQUIRED_LIBRARY_API:$REQUIRED_LIBRARY_API:$REQUIRED_LIBRARY_API" ]
then
    echo 'Incompatible shared library API.' >&2
    exit 1
fi

# Manifest-derived worker configuration; JSON is not executed or parsed on CMU.
ID=@ID@
APP=@TARGET@
ORIGINAL=@ORIGINAL@
LOCK=/tmp/mzd-@GROUP@-tweak.lock
PATCH_FILE="$HERE/assets/change.patch"

@SSH_FUNCTIONS@

# This worker chooses its own lifecycle. Other tweak types may use common.sh
# alone or common.sh + system.sh, and run their own commands instead of patching.
mzd_begin "$SELF" "$ID" mzd_system_cleanup
mzd_system_begin
mzd_require_tools awk md5sum cp cmp || exit 1
mzd_require_assets "$SELF" "$HERE/manifest.json" || exit 1
mzd_validate_firmware 74.00.324 || exit 1
mzd_system_lock "$LOCK" || exit 1

CONTEXT="$MZD_REPORT/target"
mzd_patch_prepare "$APP" "$PATCH_FILE" "$ORIGINAL" "$CONTEXT" || exit 1
STATE=$(mzd_patch_state "$CONTEXT") || exit 1
if [ "$ACTION" = status ]
then
    printf '%s\n' "$STATE" >&3
    exit 0
fi

NO_CHANGE=0
case "$ACTION:$STATE" in
    install:installed|uninstall:uninstalled) NO_CHANGE=1 ;;
esac
if [ "$NO_CHANGE" = 0 ]
then
    mzd_patch_validate_backup "$CONTEXT" || exit 1
fi

# SSH-specific variables belong to this worker, never to the common library.
USB=$MZD_USB
REPORT=$MZD_REPORT
mzd_report_message "$ACTION in progress. Do not remove the USB drive."
@SSH_PREPARE@
if [ "$NO_CHANGE" = 0 ]
then
    mzd_system_watchdog_disable || exit 1
    mzd_system_remount_rw / || exit 1
    mzd_patch_apply "$CONTEXT" "$ACTION" || exit 1
fi
@SSH_COMPLETE@

if [ "$NO_CHANGE" = 1 ]
then
    mzd_report_message "Requested setting is already present.
Reports: $MZD_REPORT"
else
    mzd_report_message "$ACTION completed. Other changes were preserved.
Reports: $MZD_REPORT"
fi
