{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Mazda v74 tweak manifest",
  "description": "Proposal for the diffpatch experiment; not an agreed upstream contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "name", "description", "version", "type", "group",
    "firmware", "entrypoint", "actions", "target", "original_md5", "lock_group",
    "status_scope"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[ -~]+$"},
    "description": {"type": "string", "minLength": 1, "pattern": "^[ -~]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "type": {"enum": ["patch", "service"]},
    "group": {"enum": ["interface", "system"]},
    "firmware": {"const": ["74.00.324"]},
    "entrypoint": {"const": "run.sh"},
    "actions": {"const": ["dialog", "install", "uninstall", "restore", "status"]},
    "target": {"type": "string", "pattern": "^/jci/[A-Za-z0-9_./-]+$"},
    "original_md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "lock_group": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "status_scope": {"const": "target-patch"}
  }
}
