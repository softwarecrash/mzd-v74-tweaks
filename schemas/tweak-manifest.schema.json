{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Mazda v74 tweak manifest",
  "description": "Proposal for the diffpatch experiment; not an agreed upstream contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "version",
    "type",
    "group",
    "firmware",
    "entrypoint",
    "actions",
    "status_scope",
    "reboot_required"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[ -~]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[ -~]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "enum": [
        "patch",
        "service",
        "command",
        "files"
      ]
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "firmware": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "entrypoint": {
      "const": "run.sh"
    },
    "actions": {
      "const": [
        "install",
        "uninstall",
        "status"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_./-]+$"
    },
    "original_md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "lock_group": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status_scope": {
      "enum": [
        "target-patch",
        "configuration",
        "payload",
        "service-health"
      ]
    },
    "reboot_required": {
      "type": "boolean"
    },
    "library_api": {
      "const": 2,
      "type": "integer"
    },
    "libraries": {
      "type": "array",
      "items": {
        "enum": [
          "common",
          "system",
          "patch"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "contains": {
        "const": "common"
      }
    }
  },
  "dependentRequired": {
    "libraries": [
      "library_api"
    ],
    "library_api": [
      "libraries"
    ]
  }
}
